# 生成物与本机数据不入库
__pycache__/
*.py[cod]
*.tmp
.venv/
venv/

# 本机数据：项目资产（提取结果/译文/几十 GB 解包内容）、封面缓存、
# 项目注册库、游戏库记录与配置（config.json 里有 API 密钥与 Cookie，绝不入库）
work/
covers/
registry.db
config.json
library.json
data/
*.log

# 打包产物
dist/
build/
*.spec

# pytest 缓存与本机私有回归样本清单（真实游戏路径，绝不入库）
.pytest_cache/
tests/private_regression_cases.json

# 本机快捷方式（指向本机 Python 安装的启动入口，各机器自行创建）
RenpyTranslatorNG.lnk
